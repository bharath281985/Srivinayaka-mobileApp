{
  "expo": {
    "name": "Sri Vinayaka",
    "slug": "sri-vinayaka-mobile",
    "version": "1.0.16",
    "icon": "./assets/logo.png",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#1a1410"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.srivinayakacollections.ios",
      "buildNumber": "16",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "LSApplicationQueriesSchemes": [
          "tez",
          "phonepe",
          "paytm",
          "gpay",
          "upi",
          "bhim",
          "kiwi",
          "paytmmp",
          "credpay"
        ]
      }
    },
    "scheme": "saree-studio",
    "android": {
      "package": "com.srivinayakacollections.android",
      "versionCode": 11016,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo.png",
        "backgroundColor": "#1a1410"
      },
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "extra": {
      "apiBaseUrl": "https://backendapis.srivinayakacollections.com",
      "imageBaseUrl": "https://backendapis.srivinayakacollections.com",
      "eas": {
        "projectId": "7800233b-37d8-40d4-9c25-bfa13b85b01c"
      }
    },
    "owner": "goexperts",
    "plugins": [
      "./plugins/withUpiQueries",
      "expo-image",
      "expo-splash-screen",
      "expo-status-bar",
      [
        "expo-image-picker",
        {
          "microphonePermission": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      [
        "@sentry/react-native",
        {
          "organization": "sri-vinayaka",
          "project": "sri-vinayaka-mobile"
        }
      ]
    ]
  }
}